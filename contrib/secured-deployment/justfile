# Generate local secrets, credentials, and certificates.
bootstrap:
    ./bootstrap.py

# Build UI for secured deployment
build-ui:
    cd ../../ui && just build
    go run -tags '!ui' ../../ui/render \
      --base-path=/ui \
      --wfx-url=https://wfx-mgmt.localhost:8443/api/wfx/v1 \
      --oauth-issuer=https://authelia.localhost:8443 \
      --oauth-client-id=wfx-ui \
      --oauth-scope="openid profile email groups offline_access read:jobs write:jobs" > ../../ui/dist/index.html

clean:
    rm -rf state

# Launch Firefox with an isolated profile that trusts the local CA.
browser:
    #!/usr/bin/env bash
    set -euo pipefail
    profile="state/firefox"
    mkdir -p "$profile"
    certutil -N -d "sql:$profile" --empty-password 2>/dev/null || true
    certutil -D -d "sql:$profile" -n "wfx local CA" 2>/dev/null || true
    certutil -A -d "sql:$profile" -n "wfx local CA" -t "C,," -i state/certs/ca.pem
    echo "Login with user: wfx-admin, pass: wfx-admin

    Press <ctrl-c> to quit..."
    exec firefox --no-remote --profile "$profile" https://wfx-mgmt.localhost:8443/ui/

_get-token CLIENT_ID AUD:
    @secret="$(cat state/{{ if CLIENT_ID == "wfxctl" { "wfxctl-client-secret" } else if CLIENT_ID == "3eb9312f-1d86-4669-a3e7-ccc69edb1dc0" { "wfx-client-1-secret" } else { "wfx-client-2-secret" } }})"; \
    oauth2c https://authelia.localhost:8443 \
      --client-id {{ CLIENT_ID }} \
      --client-secret "$secret" \
      --grant-type client_credentials \
      --auth-method client_secret_post \
      --audience {{ AUD }} \
      --scopes read:jobs,write:jobs \
      --tls-root-ca state/certs/ca.pem \
      --silent

get-wfx-admin-tokens:
    @just _get-token wfxctl wfx-northbound-api

get-wfx-client-1-tokens:
    @just _get-token 3eb9312f-1d86-4669-a3e7-ccc69edb1dc0 wfx-southbound-api

get-wfx-client-2-tokens:
    @just _get-token 78b062b5-0f10-48d3-bfa5-6a79d44a6d8b wfx-southbound-api
